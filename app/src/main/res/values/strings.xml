    <string name="perm_title">Permissions needed</string>
    <string name="perm_camera">Camera</string>
    <string name="perm_camera_why">The camera replaces the light sensor this tablet does not have. Only the average brightness of the picture and the amount of change between frames are computed. Nothing is recorded, saved, or sent anywhere.</string>
    <string name="perm_write_settings">Change system settings</string>
    <string name="perm_write_settings_why">Needed to set the screen brightness and the screen-off timeout. Android grants this on a separate settings screen, not with a normal permission dialog.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Android keeps a background service alive only while it shows a notification.</string>
