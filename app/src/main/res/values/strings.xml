    <!-- settings: items -->
    <string name="set_autobrightness">Adjust the brightness automatically</string>
    <string name="set_autobrightness_hint">Uses the camera picture instead of the missing light sensor.</string>
    <string name="set_motion">Wake the screen on movement</string>
    <string name="set_motion_hint">Without this the screen only follows the system timeout.</string>

    <string name="set_luma_min">Dark room level</string>
    <string name="set_luma_min_hint">At this camera reading and below the screen goes to its dimmest. Cover the camera with your hand and read the value on the Now tab.</string>
    <string name="set_luma_max">Bright room level</string>
    <string name="set_luma_max_hint">At this camera reading and above the screen goes to its brightest.</string>
    <string name="set_brightness_min">Dimmest screen</string>
    <string name="set_brightness_min_hint">0–255. Android will not go below 10 on this tablet.</string>
    <string name="set_brightness_max">Brightest screen</string>
    <string name="set_alpha">Adaptation speed</string>
    <string name="set_alpha_hint">Lower is smoother and slower. 0.15 reaches a new level in about ten seconds.</string>
    <string name="set_hysteresis">Ignore small adjustments</string>
    <string name="set_hysteresis_hint">Brightness is only changed when the new value differs by at least this much. Prevents visible flicker.</string>

    <string name="set_pixel_threshold">Pixel sensitivity</string>
    <string name="set_pixel_threshold_hint">How much a single pixel must change to be counted. Lower values also count camera noise.</string>
    <string name="set_motion_ratio">Movement counts as presence at</string>
    <string name="set_motion_ratio_hint">Share of the picture that must change. This keeps an already lit screen awake and drives the Home Assistant motion sensor.</string>
    <string name="set_confirm_frames">Frames in a row to confirm</string>
    <string name="set_confirm_frames_hint">Filters single noisy frames.</string>
    <string name="set_light_change_ratio">Ignore whole-picture changes above</string>
    <string name="set_light_change_ratio_hint">Switching the room light changes almost the whole picture. Anything above this share is treated as a light change, not as movement.</string>
    <string name="set_dark_cutoff">Ignore movement when darker than</string>
    <string name="set_dark_cutoff_hint">In complete darkness the camera only produces noise.</string>

    <string name="set_wake_ratio">Wake the screen only above</string>
    <string name="set_wake_ratio_hint">A person close to the tablet fills much more of the picture than someone moving on a sofa across the room. Raise this so only close-by movement wakes the screen; lower it to wake on anything.</string>
    <string name="set_wake_confirm">Frames in a row to wake</string>
    <string name="set_wake_zone">React only in the middle of the picture</string>
    <string name="set_wake_zone_hint">Wake the screen only when the movement is in front of the tablet, ignoring the edges of the view.</string>
    <string name="set_wake_zone_size">Size of the middle area</string>
    <string name="set_wake_zone_size_hint">Percent of width and height. 50 %% means the central quarter of the picture area.</string>
    <string name="set_proximity">Also wake with the proximity sensor</string>
    <string name="set_proximity_hint">Instant wake-up when a hand comes close. Most tablets have no proximity sensor — the Now tab shows whether this one does.</string>
    <string name="set_keep_awake">Keep the screen on while movement continues</string>
    <string name="set_keep_awake_hint">Uses the presence threshold, so small movements are enough to keep an already lit screen on.</string>
    <string name="set_wakelock_ms">Wake-up hold time</string>
    <string name="set_wakelock_ms_hint">How long each wake-up keeps the screen on before the system timeout takes over.</string>

    <string name="set_manage_timeout">Manage the system screen-off timeout</string>
    <string name="set_screen_timeout">Turn the screen off after</string>
    <string name="set_screen_timeout_hint">There is no way to turn the screen off directly without root, so this system timeout is what switches it off when nothing moves.</string>

    <string name="set_quiet_enabled">Enable quiet hours</string>
    <string name="set_quiet_start">From</string>
    <string name="set_quiet_end">To</string>
    <string name="set_quiet_max">Brightness limit during quiet hours</string>
    <string name="set_quiet_no_wake">Do not wake the screen during quiet hours</string>

    <string name="set_facing">Which camera to use</string>
    <string name="set_facing_front">Front</string>
    <string name="set_facing_back">Back</string>
    <string name="set_frame_interval">Look at the picture every</string>
    <string name="set_frame_interval_hint">One frame per second is enough and costs almost no CPU.</string>
    <string name="set_watchdog">Restart the camera after no frames for</string>
    <string name="set_ae_lock">Lock the camera exposure</string>
    <string name="set_ae_lock_hint">The camera normally evens out the picture, which shrinks the difference between a dark and a bright room. Locking makes the reading more honest, but it is calibrated on the scene present when the service starts.</string>
    <string name="set_exposure_comp">Exposure correction</string>

    <string name="set_root_enabled">Use root</string>
    <string name="set_root_fallback">Write system settings through root if the permission is missing</string>
    <string name="set_root_force_off">Turn the screen off myself when nothing happens</string>
    <string name="set_root_force_off_hint">Instead of waiting for the system timeout. Useful when another app keeps the screen awake.</string>
    <string name="set_root_force_off_delay">Turn it off after</string>
    <string name="set_root_auto_grant">Grant my own permissions on start</string>
    <string name="set_root_unavailable">This device has no root, or it was not granted to WakeLux.</string>

