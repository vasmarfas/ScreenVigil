    <!-- settings: items -->
    <string name="set_autobrightness">Подстраивать яркость автоматически</string>
    <string name="set_autobrightness_hint">Использует картинку с камеры вместо отсутствующего датчика освещённости.</string>
    <string name="set_motion">Включать экран при движении</string>
    <string name="set_motion_hint">Без этого экран живёт только по системному таймауту.</string>

    <string name="set_luma_min">Уровень «тёмная комната»</string>
    <string name="set_luma_min_hint">При таком показании камеры и ниже экран уходит на минимальную яркость. Закройте камеру рукой и посмотрите значение на вкладке «Сейчас».</string>
    <string name="set_luma_max">Уровень «светлая комната»</string>
    <string name="set_luma_max_hint">При таком показании камеры и выше экран выходит на максимальную яркость.</string>
    <string name="set_brightness_min">Минимальная яркость экрана</string>
    <string name="set_brightness_min_hint">0–255. Ниже 10 этот планшет всё равно не опустится.</string>
    <string name="set_brightness_max">Максимальная яркость экрана</string>
    <string name="set_alpha">Скорость подстройки</string>
    <string name="set_alpha_hint">Меньше — плавнее и медленнее. При 0.15 новый уровень набирается примерно за десять секунд.</string>
    <string name="set_hysteresis">Не реагировать на мелкие изменения</string>
    <string name="set_hysteresis_hint">Яркость меняется только если новое значение отличается хотя бы на столько. Это убирает заметное мерцание.</string>

    <string name="set_pixel_threshold">Чувствительность к пикселю</string>
    <string name="set_pixel_threshold_hint">Насколько сильно должен измениться отдельный пиксель, чтобы его посчитали. Маленькие значения начинают ловить шум камеры.</string>
    <string name="set_motion_ratio">Считать присутствием изменения от</string>
    <string name="set_motion_ratio_hint">Доля изменившейся картинки. Это удерживает уже включённый экран и питает датчик движения в Home Assistant.</string>
    <string name="set_confirm_frames">Кадров подряд для подтверждения</string>
    <string name="set_confirm_frames_hint">Отсеивает единичные шумные кадры.</string>
    <string name="set_light_change_ratio">Игнорировать изменения всей картинки выше</string>
    <string name="set_light_change_ratio_hint">Когда включают свет в комнате, меняется почти вся картинка. Всё, что выше этой доли, считается сменой освещения, а не движением.</string>
    <string name="set_dark_cutoff">Не искать движение, если темнее чем</string>
    <string name="set_dark_cutoff_hint">В полной темноте камера выдаёт только шум.</string>

    <string name="set_wake_ratio">Будить экран только при изменениях выше</string>
    <string name="set_wake_ratio_hint">Человек рядом с планшетом занимает в кадре гораздо больше места, чем тот, кто шевелится на диване в другом конце комнаты. Поднимите значение, чтобы экран включался только когда проходят рядом; опустите — чтобы будился от любого движения.</string>
    <string name="set_wake_confirm">Кадров подряд для пробуждения</string>
    <string name="set_wake_zone">Реагировать только на середину картинки</string>
    <string name="set_wake_zone_hint">Будить экран только если движение происходит прямо перед планшетом, игнорируя края кадра.</string>
    <string name="set_wake_zone_size">Размер центральной области</string>
    <string name="set_wake_zone_size_hint">Процент от ширины и высоты. 50 %% — это центральная четверть площади кадра.</string>
    <string name="set_proximity">Ещё будить по датчику приближения</string>
    <string name="set_proximity_hint">Мгновенное включение, когда рядом оказывается рука. У большинства планшетов такого датчика нет — на вкладке «Сейчас» видно, есть ли он здесь.</string>
    <string name="set_keep_awake">Не давать экрану погаснуть, пока движение продолжается</string>
    <string name="set_keep_awake_hint">Работает по порогу присутствия, поэтому уже включённый экран удерживают и мелкие движения.</string>
    <string name="set_wakelock_ms">Держать экран после пробуждения</string>
    <string name="set_wakelock_ms_hint">Сколько каждое пробуждение удерживает экран, прежде чем в дело вступит системный таймаут.</string>

    <string name="set_manage_timeout">Управлять системным временем до выключения экрана</string>
    <string name="set_screen_timeout">Выключать экран через</string>
    <string name="set_screen_timeout_hint">Без root погасить экран напрямую нельзя, поэтому именно этот системный таймаут и выключает его, когда ничего не происходит.</string>

    <string name="set_quiet_enabled">Включить тихие часы</string>
    <string name="set_quiet_start">С</string>
    <string name="set_quiet_end">До</string>
    <string name="set_quiet_max">Ограничение яркости в тихие часы</string>
    <string name="set_quiet_no_wake">Не будить экран в тихие часы</string>

    <string name="set_facing">Какую камеру использовать</string>
    <string name="set_facing_front">Фронтальную</string>
    <string name="set_facing_back">Тыловую</string>
    <string name="set_frame_interval">Смотреть на картинку каждые</string>
    <string name="set_frame_interval_hint">Одного кадра в секунду достаточно, и он почти не грузит процессор.</string>
    <string name="set_watchdog">Перезапускать камеру, если кадров нет</string>
    <string name="set_ae_lock">Заблокировать экспозицию камеры</string>
    <string name="set_ae_lock_hint">Камера обычно сама выравнивает картинку, из-за чего разница между тёмной и светлой комнатой сжимается. Блокировка делает показание честнее, но настраивается по той сцене, которая была при запуске сервиса.</string>
    <string name="set_exposure_comp">Коррекция экспозиции</string>

    <string name="set_root_enabled">Использовать root</string>
    <string name="set_root_fallback">Писать системные настройки через root, если нет разрешения</string>
    <string name="set_root_force_off">Гасить экран самому, когда ничего не происходит</string>
    <string name="set_root_force_off_hint">Вместо ожидания системного таймаута. Полезно, если другое приложение удерживает экран.</string>
    <string name="set_root_force_off_delay">Гасить через</string>
    <string name="set_root_auto_grant">Выдавать себе разрешения при запуске</string>
    <string name="set_root_unavailable">На устройстве нет root или он не выдан ScreenVigil.</string>

    <string name="set_ha_enabled">Отправлять значения в Home Assistant</string>
    <string name="set_ha_url">Адрес Home Assistant</string>
    <string name="set_ha_token">Долгоживущий токен доступа</string>
    <string name="set_ha_prefix">Префикс имён сущностей</string>
    <string name="set_ha_interval">Отправлять каждые</string>
    <string name="set_ha_test">Отправить тестовое значение</string>
    <string name="set_ha_privacy">Отправляются только числа: свет в комнате, яркость экрана, движение, состояние экрана. Сама картинка никогда не покидает планшет.</string>
    <string name="set_ha_entities">Создаёт sensor.%1$s_luma, sensor.%1$s_brightness, binary_sensor.%1$s_motion, binary_sensor.%1$s_screen, sensor.%1$s_status.</string>

    <string name="set_kiosk">Держать приложение на экране</string>
    <string name="set_kiosk_hint">Открывает его после перезагрузки и возвращает после вылета, после кнопки «Домой» или если открыли другое приложение и оставили.</string>
    <string name="set_kiosk_app">Приложение</string>
    <string name="set_kiosk_app_none">не выбрано</string>
    <string name="set_kiosk_choose">Выбрать</string>
    <string name="set_kiosk_pick_title">Какое приложение держать на экране</string>
    <string name="dialog_cancel">Отмена</string>
    <string name="set_kiosk_no_access">Нет доступа к истории использования: ScreenVigil не видит, какое приложение на экране, и поднимает выбранное только после перезагрузки или гибели его процесса.</string>
    <string name="set_kiosk_grant_access">Выдать доступ</string>
    <string name="set_kiosk_overlay">Начиная с Android 10 открыть другое приложение из фона можно только с разрешением «Поверх других окон» или через root.</string>
    <string name="set_kiosk_grant_overlay">Разрешить</string>
    <string name="set_kiosk_return">Возвращать, если другое приложение открыто дольше</string>
    <string name="set_kiosk_return_hint">С рабочего стола оно возвращается через 10 с, а при погасании экрана — сразу. Пока открыт сам ScreenVigil, приложение вернётся только когда погаснет экран.</string>
    <string name="set_kiosk_restart">Перезапускать каждые</string>
    <string name="set_kiosk_restart_hint">Только при погашенном экране и только с root. Веб-панель за несколько суток копит память, перезапуск её сбрасывает. Страница после него загружается при следующем включении экрана, на TB-X103F это около 12 с. 0 — не перезапускать.</string>
    <string name="set_kiosk_root_hint">С root ScreenVigil ещё и перезапускает приложение, когда оно зависло («не отвечает» дольше 20 с) или висит за окном об ошибке.</string>
    <string name="set_kiosk_wait_hint">После перезагрузки и вылета приложение открывается, только когда поднялась сеть и, если ниже заполнен адрес Home Assistant, сервер отвечает, но не дольше 2 мин. Приложение Home Assistant, запущенное раньше, чем сервер стал доступен, показывает ошибку подключения и само из неё не выходит.</string>

